{
  "redirects": [
    {
      "source": "/universities",
      "destination": "/our-promise",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "skilltrixa.com" }],
      "destination": "https://www.skilltrixa.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
