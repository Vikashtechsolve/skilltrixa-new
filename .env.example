# Canonical site origin for SEO (must match production + 301 redirects).
# Apex https://skilltrixa.com is normalized to www at build/runtime (see src/config/canonicalOrigin.js).
# Prefer setting www explicitly:
VITE_SITE_URL=https://www.skilltrixa.com

# Optional: prerender uses Puppeteer. If bundled Chromium fails, set your Chrome/Chromium path:
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
