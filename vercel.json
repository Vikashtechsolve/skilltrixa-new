{
  "installCommand": "npm ci && npx puppeteer browsers install chrome",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "skilltrixa.com" }],
      "destination": "https://www.skilltrixa.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
